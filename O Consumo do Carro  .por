programa {
  funcao inicio() {
    inteiro km,litros,resultado

    escreva("quantos kilometros rodados ? ")
    leia(km)

    escreva("quantos litros gastors")
    leia(litros)

    resultado = km / litros

    escreva("O resultado final sera de ",resultado," kms rodados por litro, pois quando se divide ",km," kms por ",litros," litros")


  }
}
