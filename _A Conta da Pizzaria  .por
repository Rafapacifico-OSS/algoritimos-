programa {
  funcao inicio() {

    inteiro pessoas,valortotal,valorfinal

    escreva("qual a quantidade de pessoas ?")
    leia(pessoas)

    escreva("valor total da compra?")
    leia(valortotal)

    valorfinal = valortotal / pessoas

    escreva("o valor total de R$", valortotal," , quantidade de pessoas",pessoas," você pagara ",valorfinal," ")
  }
}
