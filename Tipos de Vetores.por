programa {
  funcao inicio() {
    // sintaxe: tipo nome[tamanho]

    inteiro notas[5] //vetor de 5 inteiros
    real altura[10] //vetor de 10 reais
    cadeia nome[3] //vetor de 3 cadeias
    logico resposta[4] //vetor de 4 logicos

    // atribuindo valores individuais 

    nome[0] = "ana"
    nome[1] = "brenda"
    nome[2] = "burra"

    altura[0] = 1.5
    altura[1] =1.9
    altura[2] =2.2
    altura[3] = 1.4
    altura[4] = 2.2
    altura[5] = 1.5
    altura[6] = 1.9
    altura[7] = 2.2
    altura[8] = 1.4
    altura[9] = 2.2
    
    notas[0] = 4
    notas[1] = 5
    notas[2]  3
    notas[3] = 4
    notas[4] = 10

    resposta[0] = verdadeiro
    resposta[1] = verdadeiro
    resposta[2] = falso
    resposta[3] = falso

//////////////////////////////////////////////

    escreva(nome[0], "\n") 
    escreva(nome[1], "\n")  
    escreva(nome[2], "\n") 

    escreva(altura[0], "\n") 
    escreva(altura[1], "\n") 
    escreva(altura[2], "\n") 
    escreva(altura[3], "\n") 
    escreva(altura[4], "\n") 
    escreva(altura[5], "\n") 
    escreva(altura[6], "\n") 
    escreva(altura[7], "\n") 
    escreva(altura[8], "\n") 
    escreva(altura[9], "\n") 

    escreva(notas[0], "\n") 
    escreva(notas[1], "\n") 
    escreva(notas[2], "\n") 
    escreva(notas[3], "\n") 
    escreva(notas[4], "\n") 

    escreva(resposta[0], "\n") 
    escreva(resposta[1], "\n") 
    escreva(resposta[2], "\n") 
    escreva(resposta[3], "\n") 
  }
}
